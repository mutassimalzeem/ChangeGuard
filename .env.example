# ChangeGuard Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit real secrets to version control!

# Application
APP_NAME=ChangeGuard
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
API_PREFIX=/api/v1

# Security (JWT) - CHANGE IN PRODUCTION!
JWT_SECRET=your-super-secret-key-change-in-production-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ROUNDS=12

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/changeguard

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (MinIO/S3)
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=changeguard
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_REGION=us-east-1

# LLM / AI (optional - add your API keys)
LLM_PROVIDER=none
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_CLASSIFICATION_MODEL=gpt-4o-mini
DEFAULT_EXTRACTION_MODEL=gpt-4o-mini
DEFAULT_REASONING_MODEL=gpt-4o
DEFAULT_DRAFTING_MODEL=gpt-4o

# OCR
OCR_PROVIDER=none
OCR_LANGUAGES=["eng"]
OCR_DPI=300

# Email Ingestion (optional)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_GRAPH_CLIENT_ID=
EMAIL_GRAPH_CLIENT_SECRET=
EMAIL_GRAPH_TENANT_ID=

# Observability (optional)
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=changeguard
SENTRY_DSN=

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# File Processing
MAX_FILE_SIZE_MB=100

# Search & Retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_DOCUMENT=500
VECTOR_DIMENSION=1536
SEARCH_TOP_K=20
RERANK_TOP_K=10
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
MIN_SIMILARITY_THRESHOLD=0.65

# Workflow
APPROVAL_TIMEOUT_HOURS=72
ESCALATION_TIMEOUT_HOURS=24
MAX_APPROVAL_LEVELS=3

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60