# ChangeGuard Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=ChangeGuard
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
API_PREFIX=/api/v1

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ROUNDS=12

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/changeguard

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (MinIO/S3)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=changeguard
STORAGE_SECURE=false
STORAGE_REGION=us-east-1

# AI Models (optional - add your API keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_CLASSIFICATION_MODEL=gpt-4o-mini
DEFAULT_EXTRACTION_MODEL=gpt-4o-mini
DEFAULT_REASONING_MODEL=gpt-4o
DEFAULT_DRAFTING_MODEL=gpt-4o

# Email Ingestion (optional)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_GRAPH_CLIENT_ID=
EMAIL_GRAPH_CLIENT_SECRET=
EMAIL_GRAPH_TENANT_ID=

# Observability (optional)
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=changeguard
SENTRY_DSN=

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]