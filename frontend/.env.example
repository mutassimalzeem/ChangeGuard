# --- ChangeGuard frontend (6.1) -------------------------------------------------
# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined into
# the browser bundle at build time: never put a secret in this file.

# Origin of the ChangeGuard API (the FastAPI service) including its API prefix,
# without a trailing slash. The browser calls `<BASE>/auth/login`, `<BASE>/projects`
# and so on, and sends the access token in the `Authorization: Bearer` header.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional stale time (milliseconds) for TanStack Query data. Default: 30000.
# NEXT_PUBLIC_QUERY_STALE_TIME_MS=30000
