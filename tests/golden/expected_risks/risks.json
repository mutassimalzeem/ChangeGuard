      "id": "DUP-001",
      "title": "Exact Duplicate Change Order Claim Resubmission",
      "category": "duplicate_detection",
      "input": {
        "primary_document": {
          "document_id": "co-orig-001",
          "filename": "CO-2026-001_Approved.pdf",
          "document_type": "change_order",
          "co_number": "CO-2026-001",
