  "conflicting_evidence": [
    {
      "id": "CONF-001",
      "title": "Weather Contradiction: Clear Site Log vs Torrential Rain Claim",
      "category": "conflicting_evidence",
      "input": {
        "document_a": {
          "document_id": "dr-2026-03-14",
          "filename": "DR-2026-03-14_DailyReport.pdf",
          "document_type": "daily_report",
          "source_page": 1,
          "snippet": "Weather: Clear and sunny, 24C, wind 8 km/h. Placed 220 m3 concrete.",
          "date": "2026-03-14",
          "weather": "clear_and_sunny",
          "recorded_rainfall_mm": 0.0
        },
        "document_b": {
          "document_id": "clm-rain-0314",
          "filename": "CLM-2026-008_RainfallDelay.pdf",
          "document_type": "change_order",
          "source_page": 1,
          "snippet": "Severe torrential rainfall of 65mm flooded Zone B, causing full site shutdown on 2026-03-14.",
          "date": "2026-03-14",
          "claimed_condition": "torrential_rainfall",
          "claimed_rainfall_mm": 65.0,
          "claimed_impact_days": 3
        }
      },
      "expected_output": {
        "conflict_detected": true,
        "risk_type": "conflicting_information",
        "severity": "high",
        "contradiction_key": "weather_conditions_on_2026-03-14",
        "conflict_summary": "Daily report DR-2026-03-14 records 0mm rainfall and active concrete pour, whereas Claim CLM-2026-008 asserts 65mm torrential rain and site shutdown.",
        "sources": [
          {
            "document_id": "dr-2026-03-14",
            "page": 1,
            "snippet": "Clear and sunny, 24C. Placed 220 m3 concrete."
          },
          {
            "document_id": "clm-rain-0314",
            "page": 1,
            "snippet": "Severe torrential rainfall of 65mm flooded Zone B"
          }
        ],
        "recommended_action": "Resolve the conflicting values with the document issuer."
      },
      "evaluation_criteria": {
        "metric": "deterministic_rule_match",
        "rule_name": "conflicting_information",
        "assertions": {
          "conflict_detected": true,
          "both_sources_cited": true
        }
      }
    },
